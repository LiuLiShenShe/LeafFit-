# Ignore everything
build/
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.dylib
*.ini

*.mtl
*.obj

# Only oversized binaries are ignored — everything else (tables, json, figures,
# npy labels, code) stays tracked.
# - *.ply: point clouds, up to 30MB each (~6.4GB total across tasks)
# - *.npz: projection/view-signature caches, 20MB-817MB each (~5GB total)
*.ply
*.npz

# J-Space controller working directory (internal tooling state)
.jspace/
# Task5R-v3: heavy review crops and projection caches stay local
outputs/task5r_v3/review_crops/
outputs/task5r_v3/projection_cache/
outputs/task5r_v3/edge_scores_v3.csv
